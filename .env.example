# Copier en .env : cp .env.example .env
# Aucune valeur sensible ici. Les clés locales de Supabase sont écrites par `make up`
# dans .env.supabase ; les clés réelles (LLM, mails) ne se mettent que dans .env.

# Port de l'application sur la machine (http://localhost:3000)
APP_PORT=3000

# URL de Supabase vue par le navigateur (Supabase local lancé par la CLI)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Secret partagé entre le webhook Supabase et les endpoints /api (ADR-0005).
# Générer une valeur : openssl rand -hex 32
WEBHOOK_SECRET=

# Fournisseur LLM : fake (faux client, sans appel payant), anthropic, mistral ou openai
LLM_PROVIDER=fake
LLM_API_KEY=

# Fournisseur de mails : resend ou brevo (à trancher)
MAILER_PROVIDER=
MAILER_API_KEY=

# Simulateur du formateur (E0.17), lancé par `make up` en mode démonstration.
# Clé d'équipe : demo-key en local. Avec un serveur du formateur, mettre la clé qu'il fournit.
# Elle reste côté serveur : jamais NEXT_PUBLIC_, jamais dans le navigateur.
SIMULATEUR_TEAM_KEY=demo-key
# Depuis le conteneur de l'application, le simulateur est joignable par le nom du service.
SIMULATEUR_URL=http://simulateur:8765
# Délai maximal d'une requête, en millisecondes
SIMULATEUR_DELAI_MS=5000
# Panne simulée par notre adaptateur : aucune, delai ou erreur_serveur
SIMULATEUR_PANNE=aucune
# Port du simulateur sur la machine (http://localhost:8765/dashboard)
SIMULATEUR_PORT=8765
